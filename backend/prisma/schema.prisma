datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin") // "admin" or "superadmin"
  blogs        Blog[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

model Event {
  id               String              @id @default(uuid())
  title            String
  shortDescription String              @map("short_description")
  fullDescription  String              @map("full_description")
  bannerUrl        String              @map("banner_url")
  galleryUrls      String              @default("[]") @map("gallery_urls") // SQLite doesn't support String[], we store as stringified JSON
  videoUrl         String?             @map("video_url")
  eventDate        DateTime            @map("event_date")
  venue            String
  registrationLink String?             @map("registration_link")
  sdgAlignment     String              @default("[]") @map("sdg_alignment") // SQLite doesn't support String[], we store as stringified JSON
  category         String
  status           String              @default("Upcoming") // "Upcoming" or "Completed"
  isDeleted        Boolean             @default(false) @map("is_deleted")
  registrations    EventRegistration[]
  media            Media[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([isDeleted])
  @@index([category])
  @@index([status])
  @@index([eventDate])
  @@map("events")
}

model TeamMember {
  id              String   @id @default(uuid())
  name            String
  position        String
  affiliation     String?
  contact         String?
  profileImageUrl String   @map("profile_image_url")
  linkedinUrl     String?  @map("linkedin_url")
  orderIndex      Int      @default(0) @map("order_index")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([orderIndex])
  @@map("team_members")
}

model Blog {
  id            String   @id @default(uuid())
  title         String
  content       String
  thumbnailUrl  String   @map("thumbnail_url")
  tags          String   @default("[]") @map("tags") // SQLite compatibility
  publishStatus String   @default("Draft") @map("publish_status")
  authorId      String?  @map("author_id")
  author        Admin?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([publishStatus])
  @@index([createdAt])
  @@map("blogs")
}

model Media {
  id                 String   @id @default(uuid())
  fileName           String   @map("file_name")
  fileUrl            String   @map("file_url")
  fileType           String   @map("file_type")
  fileSize           Int      @map("file_size")
  cloudinaryPublicId String   @map("cloudinary_public_id")
  eventId            String?  @map("event_id")
  event              Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([eventId])
  @@index([fileType])
  @@map("media")
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  link      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("announcements")
}

model Contact {
  id         String   @id @default(uuid())
  name       String
  email      String
  subject    String?
  message    String
  isResolved Boolean  @default(false) @map("is_resolved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isResolved])
  @@map("contacts")
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@map("newsletter_subscribers")
}

model EventRegistration {
  id                  String   @id @default(uuid())
  eventId             String   @map("event_id")
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name                String
  email               String
  contact             String?
  registrationDetails String?  @map("registration_details") // stored as JSON string
  registeredAt        DateTime @default(now()) @map("registered_at")

  @@index([eventId])
  @@map("event_registrations")
}

model StudentBranch {
  id          String          @id @default(uuid())
  name        String          @unique
  code        String?         
  established DateTime?       
  logoUrl     String?         @map("logo_url")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  officers    BranchOfficer[]

  @@map("student_branches")
}

model BranchOfficer {
  id              String        @id @default(uuid())
  name            String
  role            String        
  ieeeNumber      String?       @map("ieee_number")
  email           String?
  year            Int           
  branchId        String        @map("branch_id")
  studentBranch   StudentBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("branch_officers")
}

model GrantAndAward {
  id           String   @id @default(uuid())
  title        String
  category     String   
  organization String
  amount       String
  year         String
  status       String   
  badgeColor   String?  @map("badge_color")
  icon         String   @default("Award")
  description  String
  impact       String?
  linkUrl      String?  @map("link_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("grants_and_awards")
}
